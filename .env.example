# Supabase Database Configuration
# Get these values from your Supabase project settings

# Database password
SUPABASE_DB_PASS=your_db_password_here

# Direct connection string (use for direct database connections)
SUPABASE_DIRECT_CONNECTION_STRING=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Pooler connection string (recommended for server-side, uses pgBouncer for connection pooling)
SUPABASE_POOLER_CONNECTION_STRING=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase API credentials
SUPABASE_PERSONAL_ACCESS_TOKEN=your_personal_access_token
SUPABASE_PROJECT_REF=your_project_ref

# Client-side Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key
